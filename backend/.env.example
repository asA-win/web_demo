# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dubai_restaurant

# Security & JWT
SECRET_KEY=replace_with_a_strong_secret_key_minimum_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "https://layalidubai.ae"]

# Restaurant Info
RESTAURANT_NAME=Layali Dubai — Royal Lounge & Dining
RESTAURANT_CURRENCY=AED
